@@ -78,7 +80,39 @@ QString sentence(const DocumentModel& doc, const DocumentModel::MoveResult& r, T
 
 QString dragStatus(const DocumentModel& doc, const DocumentModel::MoveResult& r)
 {
-    return t("%1 — %2").arg(sentence(doc, r, Tense::Present), escHint());
+    // A target the block already stands at (ruling D15): its indicator stays,
+    // because the hand is genuinely over it, but "Drop to move" would promise
+    // a move the release does not make.
+    if (r.check == DocumentModel::MoveCheck::NoChange) return alreadyHere();
+    QString line = sentence(doc, r, Tense::Present);
+    // CARRIED OUT OF SEVERAL FOLDERS (finding F11): a folder click selects a
+    // whole subtree, and dragging one of its bodies carries all of them out of
+    // their subfolders - so the line says so before the release, not after.
+    const QString spread = foldersLeft(doc, r);
+    if (!spread.isEmpty()) line = t("%1 — %2").arg(line, spread);
+    return t("%1 — %2").arg(line, escHint());
+}
+
+QString foldersLeft(const DocumentModel& doc, const DocumentModel::MoveResult& r)
+{
+    // Where each carried row stands now. Only a spread across MORE THAN ONE
+    // folder is worth a clause: everything out of one folder is already said
+    // by where() ("out of Carcass"), and loose top-level rows leave no folder.
+    std::vector<int> from;
+    for (int id : r.carried) {
+        const int parent = doc.groupOf(id);
+        if (parent > 0 && std::find(from.begin(), from.end(), parent) == from.end())
+            from.push_back(parent);
+    }
+    if (from.size() < 2) return QString();
+    // ...and of those, the folders this drop actually takes something out of:
+    // the destination keeps whatever was already in it.
+    std::vector<int> left;
+    for (int folder : from)
+        if (folder != r.parent) left.push_back(folder);
+    if (left.empty()) return QString();
+    if (left.size() == 1) return t("takes some out of %1").arg(nameOf(doc, left.front()));
+    return t("takes them out of %1 folders").arg(left.size());
 }
 
