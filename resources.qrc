<!DOCTYPE RCC>
<RCC version="1.0">
  <qresource prefix="/fonts">
    <!-- Aliased: the real filename contains a comma (the variable font's axis
         list), which is awkward to reference in code. -->
    <file alias="DMSans.ttf">assets/fonts/DMSans-VariableFont_opsz,wght.ttf</file>
  </qresource>
  <qresource prefix="/icons">
    <file alias="app.png">assets/Icon.png</file>
  </qresource>
  <!-- The default wood (the 2026-10 review's F11): compiled in as well as
       copied beside the binary, so render mode's default never depends on
       what was deployed. 142 KB. -->
  <qresource prefix="/materials">
    <file alias="oak-natural.jpg">assets/materials/oak-natural.jpg</file>
  </qresource>
</RCC>
