{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-base",
      "hidden": true,
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "C:/vcpkg/scripts/buildsystems/vcpkg.cmake",
        "VCPKG_TARGET_TRIPLET": "x64-windows-release",
        "VCPKG_HOST_TRIPLET": "x64-windows-release",
        "CMAKE_CONFIGURATION_TYPES": "Release;RelWithDebInfo"
      }
    },
    {
      "name": "windows",
      "inherits": "windows-base",
      "displayName": "Windows: installer Qt 6.11.1 with WebEngine + vcpkg OCCT (the app)",
      "binaryDir": "${sourceDir}/build-web",
      "cacheVariables": {
        "FURNIFYME_WEB_UI": "ON",
        "VCPKG_APPLOCAL_DEPS": "OFF",
        "Qt6_DIR": "C:/Qt/6.11.1/msvc2022_64/lib/cmake/Qt6",
        "CMAKE_PREFIX_PATH": "C:/Qt/6.11.1/msvc2022_64",
        "Qt6CoreTools_DIR": "C:/Qt/6.11.1/msvc2022_64/lib/cmake/Qt6CoreTools",
        "Qt6GuiTools_DIR": "C:/Qt/6.11.1/msvc2022_64/lib/cmake/Qt6GuiTools",
        "Qt6WidgetsTools_DIR": "C:/Qt/6.11.1/msvc2022_64/lib/cmake/Qt6WidgetsTools"
      }
    },
    {
      "name": "windows-headless",
      "inherits": "windows-base",
      "displayName": "Windows, geometry + headless test only (no Qt)",
      "binaryDir": "${sourceDir}/build-headless",
      "cacheVariables": {
        "FURNIFYME_BUILD_APP": "OFF",
        "FURNIFYME_WEB_UI": "OFF"
      }
    },
    {
      "name": "windows-web",
      "inherits": "windows",
      "displayName": "Windows (the same as the windows preset - kept for older notes)"
    },
    {
      "name": "linux",
      "displayName": "Linux (system OCCT + Qt6 from apt)",
      "generator": "Unix Makefiles",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "linux-headless",
      "inherits": "linux",
      "displayName": "Linux, geometry + headless test only (no Qt)",
      "binaryDir": "${sourceDir}/build-headless",
      "cacheVariables": {
        "FURNIFYME_BUILD_APP": "OFF",
        "FURNIFYME_WEB_UI": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows",
      "configurePreset": "windows",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-headless",
      "configurePreset": "windows-headless",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "windows-web",
      "configurePreset": "windows-web",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    },
    {
      "name": "linux-headless",
      "configurePreset": "linux-headless"
    }
  ],
  "testPresets": [
    {
      "name": "windows-headless",
      "configurePreset": "windows-headless",
      "configuration": "RelWithDebInfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux-headless",
      "configurePreset": "linux-headless",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
